<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebUi</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebUi.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />

</head>
<body>
    <header data-bs-theme="dark">
        <nav class="navbar navbar-expand-lg navbar-dark bg-body-tertiary border-bottom shadow-sm mb-4">
            <div class="container">


                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <span class="material-symbols-rounded">
                        hospital
                    </span>
                    MedSched
                </a>

                <!-- Toggle mobile -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Itens -->
                <div class="collapse navbar-collapse" id="mainNav">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1" asp-page="/Index">
                                <span class="material-symbols-rounded">home</span>
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1" asp-page="/Privacy">
                                <span class="material-symbols-rounded">shield</span>
                                Privacidade
                            </a>
                        </li>

                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-1"
                                   href="#" id="medMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="material-symbols-rounded">calendar_month</span>
                                    Agenda
                                </a>

                                <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="medMenu">

                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2"
                                           asp-page="/Schedule/Available">
                                            <span class="material-symbols-rounded">schedule</span>
                                            Meus horários disponíveis
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2"
                                           asp-page="/Schedule/Appointments">
                                            <span class="material-symbols-rounded">event_note</span>
                                            Agendamentos feitos
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2"
                                           asp-page="/Schedule/NewSlot">
                                            <span class="material-symbols-rounded">add_circle</span>
                                            Adicionar novos horários
                                        </a>
                                    </li>

                                </ul>
                            </li>
                        }
                    </ul>


                    <ul class="navbar-nav">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-1"
                                   asp-page="/Auth/Signout">
                                    <span class="material-symbols-rounded">logout</span>
                                    Sair
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-1"
                                   asp-page="/Auth/Login">
                                    <span class="material-symbols-rounded">login</span>
                                    Login
                                </a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - WebUi - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
