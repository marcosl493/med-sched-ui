@page
@model NewSlotModel
@{
    ViewData["Title"] = "Adicionar Horário Disponível";
}

<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet" />

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-dark text-white d-flex align-items-center">
            <span class="material-icons-round me-2">schedule</span>
            <h5 class="m-0">Novo Horário Disponível</h5>
        </div>

        <div class="card-body">

            <form method="post">
                <div class="mb-3">
                    <label asp-for="@Model.StartDate" class="form-label">
                        <span class="material-icons-round align-middle me-1">calendar_today</span>
                        Hora de início
                    </label>
                    <input asp-for="@Model.StartDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="@Model.StartDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="@Model.EndDate" class="form-label">
                        <span class="material-icons-round align-middle me-1">event</span>
                        Hora de término
                    </label>
                    <input asp-for="@Model.EndDate" type="time" class="form-control" />
                    <span asp-validation-for="@Model.EndDate" class="text-danger"></span>
                </div>

                <div class="form-check form-switch mb-3">
                    <input asp-for="@Model.RepeatWeekly" class="form-check-input" id="switchRepetir" />
                    <label class="form-check-label" for="switchRepetir">
                        <span class="material-icons-round align-middle me-1">repeat</span>
                        Repetir por semanas
                    </label>
                </div>

                <div id="repeatContainer" style="display:none;">
                    <div class="mb-3">
                        <label asp-for="@Model.WeeksToRepeat" class="form-label">
                            <span class="material-icons-round align-middle me-1">numbers</span>
                            Quantas semanas repetir?
                        </label>
                        <input asp-for="@Model.WeeksToRepeat" type="number" min="1" class="form-control" />
                        <span asp-validation-for="@Model.WeeksToRepeat" class="text-danger"></span>
                    </div>

                    <label class="form-label">
                        <span class="material-icons-round align-middle me-1">date_range</span>
                        Escolha os dias da semana:
                    </label>

                    <div class="row">
                        @foreach (var day in Enum.GetValues(typeof(DayOfWeek)).Cast<DayOfWeek>())
                        {
                            <div class="col-md-3 mb-2">
                                <div class="form-check">
                                    <input type="checkbox" name="SelectedDays" value="@((int)day)" class="form-check-input" id="day_@day" />
                                    <label class="form-check-label" for="day_@day">@day</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-dark mt-3">
                    <span class="material-icons-round align-middle me-1">check_circle</span>
                    Salvar
                </button>
            </form>
            @Html.ValidationSummary(true)
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const repetirSwitch = document.getElementById("switchRepetir");
        const repeatContainer = document.getElementById("repeatContainer");

        function toggleRepeat() {
            repeatContainer.style.display = repetirSwitch.checked ? "block" : "none";
        }

        repetirSwitch.addEventListener("change", toggleRepeat);
        toggleRepeat();
    </script>
}
