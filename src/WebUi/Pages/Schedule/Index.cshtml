@page
@model WebUi.Pages.Schedule.IndexModel
@{
    ViewData["Title"] = "Horários cadastrados";
}

<div asp-validation-summary="All" class="text-danger"></div>

<div class="timeline-wrapper mb-5">

    <h4 class="mb-3">Timeline dos horários</h4>

    <ul class="timeline">
        @foreach (var s in Model.Schedules)
        {
            <li class="timeline-item">
                <div class="card p-3 shadow-sm">
                    <div class="d-flex justify-content-between">
                        <strong>@s.StartTime.ToLocalTime().ToString("dd/MM HH:mm")</strong>
                        <strong>@s.EndTime.ToLocalTime().ToString("dd/MM HH:mm")</strong>
                    </div>

                    @if (s.IsAvaliable)
                    {
                        <span class="badge bg-success mt-2">Disponível</span>
                    }
                    else
                    {
                        <span class="badge bg-danger mt-2">Indisponível</span>
                    }

                    <div class="mt-2 small text-muted">
                        Dr. @s.Physician.Name — @s.Physician.Specialty
                    </div>
                </div>
            </li>
        }
    </ul>
</div>

<hr />

<div class="card mt-4 shadow-sm">
    <div class="card-body">

        <form method="get" class="row g-3 align-items-end mb-3">

            <div class="col-md-3">
                <label class="form-label small fw-bold">Itens por página</label>
                <input class="form-control form-control-sm" type="number" name="Top" value="@Model.Top" min="1" />
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold">Página</label>
                <input class="form-control form-control-sm" type="number" name="Skip" value="@Model.Skip" min="0" />
            </div>

            <div class="col-md-3">
                <button class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-filter"></i> Filtrar
                </button>
            </div>

        </form>

        <nav class="d-flex justify-content-center">
            <ul class="pagination mb-0">

                <li class="page-item @(Model.Skip == 0 ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-skip="@(Model.Skip - 1)"
                       asp-route-top="@Model.Top">
                        « Anterior
                    </a>
                </li>

                <li class="page-item active">
                    <span class="page-link">
                        Página @Model.Skip
                    </span>
                </li>

                <li class="page-item">
                    <a class="page-link"
                       asp-route-skip="@(Model.Skip + 1)"
                       asp-route-top="@Model.Top">
                        Próxima »
                    </a>
                </li>

            </ul>
        </nav>

    </div>
</div>


<style>
    .timeline {
        list-style: none;
        padding-left: 20px;
        border-left: 3px solid #0d6efd;
    }

    .timeline-item {
        margin-bottom: 25px;
        position: relative;
    }

        .timeline-item::before {
            content: "";
            width: 14px;
            height: 14px;
            background: #0d6efd;
            border-radius: 50%;
            position: absolute;
            left: -10px;
            top: 5px;
        }
</style>
