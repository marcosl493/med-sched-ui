@page
@using static Application.Interfaces.Repositories.IMedSchedRepository
@model WebUi.Pages.Appointment.IndexModel
@{
    ViewData["Title"] = "Agendamentos de consultas";
}
@* Função para verificar estilo por status *@
@functions {
    (string Color, string Icon) GetStatusStyle(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.SCHEDULED => ("primary", "schedule"), // ícone relógio
            AppointmentStatus.CANCELED => ("danger", "cancel"),   // ícone X
            _ => ("secondary", "info")
        };
    }
}

<div class="card mt-4 shadow-sm">
    <div class="card-body">

        <h5 class="fw-bold mb-3">Linha do tempo de agendamentos</h5>

        <!-- Timeline -->
        <div class="timeline mb-4">
            @foreach (var a in Model.Appointments.Appointments)
            {
                var style = GetStatusStyle(a.Status);

                <div class="timeline-item mb-4 d-flex">
                    <div class="timeline-marker bg-@style.Color me-3"></div>

                    <div class="timeline-content card flex-fill shadow-sm border-start border-3 border-@style.Color">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold mb-1 d-flex align-items-center gap-2">
                                    <span class="material-symbols-rounded text-@style.Color" style="font-size:20px;">
                                        @style.Icon
                                    </span>
                                    @a.Patient.Name
                                </h6>

                                <span class="badge bg-@style.Color">
                                    @a.Status
                                </span>
                            </div>

                            <div class="small text-muted mb-2">
                                Criado em: @a.CreatedAt.ToString("dd/MM/yyyy")
                            </div>

                            <div class="mt-2">
                                <div><strong>Início:</strong> @a.StartTime.ToString("ddd dd/MM HH:mm")</div>
                                <div><strong>Fim:</strong> @a.EndTime.ToString("HH:mm")</div>
                            </div>

                            <div class="mt-2 text-muted small">
                                <strong>ID:</strong> @a.Id
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>

        <style>
            .timeline {
                position: relative;
                margin-left: 20px;
            }

                .timeline::before {
                    content: "";
                    position: absolute;
                    left: 10px;
                    top: 0;
                    bottom: 0;
                    width: 2px;
                    background: #dee2e6;
                }

            .timeline-item {
                position: relative;
            }

            .timeline-marker {
                width: 14px;
                height: 14px;
                border-radius: 50%;
                margin-top: 6px;
            }
        </style>

        <div class="d-flex justify-content-center mt-4">
            <ul class="pagination mb-0">

                <li class="page-item @(Model.Skip == 0 ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-Skip="@(Model.Skip - 1)"
                       asp-route-Top="@Model.Top">
                        « Anterior
                    </a>
                </li>

                <li class="page-item active">
                    <span class="page-link">
                        Página @(Model.Skip + 1)
                    </span>
                </li>

                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link"
                       asp-route-Skip="@(Model.Skip + 1)"
                       asp-route-Top="@Model.Top">
                        Próxima »
                    </a>
                </li>

            </ul>
        </div>

        <div class="text-muted small mt-3 text-center">
            Total de registros: <strong>@Model.Appointments.Count</strong>
        </div>

    </div>
</div>
